# ===== LLM 配置（OpenAI 兼容，可切换 DeepSeek / Coze 网关）=====
# DeepSeek 官方:  https://api.deepseek.com  (model: deepseek-chat)
# Coze 网关:      https://llm-gateway.coze.cn/v1 (model: deepseek-v3-250324)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===== 服务端口 =====
PORT=3100

# ===== 上传限制 =====
MAX_FILE_SIZE_MB=20
